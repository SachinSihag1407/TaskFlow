# Copy to .env and fill in the secrets. Never commit .env.
# Generate strong values with: openssl rand -base64 24

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Optional ---------------------------------------------------------------
# development | production. Production defaults to Secure cookies and refuses
# demo seeding and private-network webhooks.
TASKFLOW_ENV=development
LOG_LEVEL=info

# Password for the demo users created by `docker compose run --rm seed`
# (admin@example.com, operator@example.com, viewer@example.com).
# Leave empty to have the seed command generate and print one.
SEED_PASSWORD=

# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Self-service workspace registration.
ALLOW_REGISTRATION=true
RATE_LIMIT_REGISTER_PER_HOUR=5
# Comma-separated emails of workspace admins allowed to operate shared
# infrastructure (drain workers). Workers serve every workspace, so ordinary
# workspace admins cannot. Example: PLATFORM_ADMIN_EMAILS=admin@example.com
PLATFORM_ADMIN_EMAILS=
# Bearer token required to scrape the API's /metrics (empty = no token).
METRICS_TOKEN=

WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_GRACE=30s

# Host ports (bound to 127.0.0.1 except the web UI).
WEB_PORT=8080
API_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_USER=taskflow
POSTGRES_DB=taskflow
